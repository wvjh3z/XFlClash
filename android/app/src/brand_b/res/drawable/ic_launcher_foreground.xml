<?xml version="1.0" encoding="utf-8"?>
<!-- Both layers fill the same bounds. The vector viewport matches the bitmap's
     108dp canvas, so the 70/108 white disc and red silhouette scale together.
     No fixed layer size or center-only bitmap gravity: notification sizes vary. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <vector android:width="108dp" android:height="108dp"
            android:viewportWidth="108" android:viewportHeight="108">
            <path android:fillColor="#FFFFFF"
                android:pathData="M54,19 a35,35 0,1 0,0,70 a35,35 0,1 0,0,-70" />
        </vector>
    </item>
    <item>
        <bitmap android:src="@mipmap/ic_fg" android:gravity="fill" />
    </item>
</layer-list>
