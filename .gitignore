# FVM Version Cache
.fvm/
.fvmrc

# Xboard flavor 生成产物（含 CI 注入的 aesKey / sentryDsn，绝不入 git，D58/conventions §7.1）
/flavor_defines.json

# 桌面品牌注入产物（tool/inject_desktop_brand.dart 构建期生成，CI 跑 flutter_launcher_icons 用，绝不入 git）
/flutter_launcher_icons.yaml

# Xboard 本地密钥/凭据记录（开发自测用，绝不入 git）
/.secrets/
*.secrets.md
test/xboard/golden/failures/

# 品牌私密配置（不进 git，CI 从 BRAND_*_FLAVOR_YAML_B64 / BRAND_*_FALLBACK_BIN_B64 secret 还原；本地保留）
flavors/*/flavor.yaml
flavors/*/assets/fallback.bin

# Sentry CLI 上传符号用的 org auth token（构建机凭证，绝不入 git/app；CI 走 SENTRY_AUTH_TOKEN secret）
# org 级、a/b 共用，收进 flavors/ 机密包（换机器整目录拷即可）；构建脚本 export 给 sentry-cli。
flavors/sentry-cli.token

# Coverage reports (local dev only)
/coverage/

# 本地构建/调试临时目录（日志、临时脚本，不入库）
/.tmp/

# 本机 Android 开发构建计数；GitHub 继续使用 scripts/build_number.<brand>.txt。
# 放在 build/ 外，避免 flutter clean 清除；不要 git add -f。
/.local-build/
