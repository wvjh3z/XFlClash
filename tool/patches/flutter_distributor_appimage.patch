+  // Compare bounded chunks rather than loading large shared objects at once.
+  Future<bool> _sameContents(String first, String second) async {
+    final a = File(first);
+    final b = File(second);
+    if (await a.length() != await b.length()) return false;
+    final left = await a.open();
+    try {
+      final right = await b.open();
+      try {
+        while (true) {
+          final x = await left.read(64 * 1024);
+          final y = await right.read(64 * 1024);
+          if (x.length != y.length) return false;
+          for (var i = 0; i < x.length; i++) {
+            if (x[i] != y[i]) return false;
+          }
+          if (x.isEmpty) return true;
+        }
+      } finally {
+        await right.close();
+      }
+    } finally {
+      await left.close();
+    }
+  }
